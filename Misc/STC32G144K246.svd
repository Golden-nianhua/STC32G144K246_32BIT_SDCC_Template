          <addressOffset>0x5</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ADCETR_PS</name>
              <description>ADC 外部触发脚ADC_ETR 功能脚选择</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>P1.2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>P4.3</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>-</description>
                  <value>2</value>
