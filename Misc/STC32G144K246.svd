                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>串口4 模式0 的波特率6 倍速，即固定为Fosc/12*6 ＝ Fosc/2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S4BRT</name>
              <description>串口4 波特率发生器选择位</description>
