                  <name>Value_1</name>
                  <description>串口5 模式0 的波特率6 倍速，即固定为Fosc/12*6 ＝ Fosc/2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
