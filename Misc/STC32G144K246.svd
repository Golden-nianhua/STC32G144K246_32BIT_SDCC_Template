                <enumeratedValue>
                  <name>Value_0</name>
                  <description>DAC1 中断优先级为0 级（最低级）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>DAC1 中断优先级为1 级（较低级）</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>DAC1 中断优先级为2 级（较高级）</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>DAC1 中断优先级为3 级（最高级）</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EDAC1I</name>
              <description>DAC1中断控制位</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止DAC1 中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能DAC1 中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DAC1EN</name>
              <description>DAC1模块使能控制位</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止DAC1 功能</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能DAC1 功能</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DAC1_STA</name>
          <description>DAC1状态寄存器</description>
          <addressOffset>0x1</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>BUSY</name>
              <description>DAC1模块忙标准位（只读）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DAC1IF</name>
              <description>DAC1中断请求标志位，需要软件写0清零</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DAC1_DIVH</name>
          <description>DAC1时钟分频寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DAC1_DIV</name>
              <description>DAC1 时钟分频。 DAC1 模块的工作频率=系统时钟 / 4 / DAC1_DIV[9:0]，当DAC1_DIV[9:0]的值为0 时，DAC1 直接使用 系统时钟。 必须保证DAC1 模块的工作频率不得高于2MHz</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DAC1_DIVL</name>
          <description>DAC1时钟分频寄存器</description>
          <addressOffset>0x5</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DAC1_DIV</name>
              <description>DAC1 时钟分频。 DAC1 模块的工作频率=系统时钟 / 4 / DAC1_DIV[9:0]，当DAC1_DIV[9:0]的值为0 时，DAC1 直接使用 系统时钟。 必须保证DAC1 模块的工作频率不得高于2MHz</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
