            </field>
          </fields>
        </register>
        <register>
          <name>PWMC_BKR</name>
          <description>PWMC刹车寄存器</description>
          <addressOffset>0x2c</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>MOEC</name>
              <description>主输出使能。一旦刹车输入有效，该位被硬件异步清0。根据AOE 位的设置值，该位可以由软 件置1 或被自动置1。它仅对配置为输出的通道有效。（n=A/B/C/D/E/F）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止OC 和OCN 输出或强制为空闲状态</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>如果设置了相应的使能位（PWMn_CCERX 寄存器的CCIE 位），则使能OC 和OCN 输出。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AOEC</name>
              <description>自动输出使能（n=A/B/C/D/E/F）</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>MOE 只能被软件置1；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>MOE 能被软件置1 或在下一个更新事件被自动置1（如果刹车输入无效）。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BKPC</name>
              <description>刹车输入极性（n=A/B/C/D/E/F）</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>刹车输入低电平有效</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>刹车输入高电平有效</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BKEC</name>
              <description>刹车功能使能（n=A/B/C/D/E/F）</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止刹车输入（BRK）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>开启刹车输入（BRK）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OSSRC</name>
              <description>运行模式下“关闭状态”选择。该位在MOE=1 且通道设为输出时有效（n=A/B/C/D/E/F）</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当PWM 不工作时，禁止OC/OCN 输出（OC/OCN 使能输出信号=0）；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当 PWM 不工作时，一旦 CCiE=1 或 CCiNE=1，首先开启 OC/OCN 并输出无效电平，然后置</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OSSIC</name>
              <description>空闲模式下“关闭状态”选择。该位在MOE=0 且通道设为输出时有效。（n=A/B/C/D/E/F）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当PWM 不工作时，禁止OC/OCN 输出（OC/OCN 使能输出信号=0）；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当PWM 不工作时，一旦CCiE=1 或CCiNE=1，OC/OCN 首先输出其空闲电平，然后 OC/OCN</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOCKC</name>
              <description>锁定设置。该位为防止软件错误而提供的写保护措施（n=A/B/C/D/E/F）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>保护级别：无保护；保护内容：寄存器无写保护</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>保护级别：锁定级别1；保护内容：不能写入PWMn_BKR寄存器的MOE、BKE、BKP、AOE位和PWMn_OISR寄存器的OISI位</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>保护级别：锁定级别2；保护内容：不能写入锁定级别1中的各位，也不能写入CC极性位以及OSSR/OSSI位</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>保护级别：锁定级别3；保护内容：不能写入锁定级别2中的各位，也不能写入CC控制位</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMC_CCR5H</name>
          <description>PWMC捕获比较寄存器5</description>
          <addressOffset>0xaf</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRC5</name>
              <description>捕获/比较5 的16 位值（n=A/C/E） CCRn5 包含了装入当前比较值（预装载值）。如果在PWMn_CCMR5 寄存器（OCn5PE 位）中未选 择预装载功能，写入的数值会立即传输至当前寄存器中。否则只有当更新事件发生时，此预装载 值才传输至当前捕获/比较5 寄存器中。当前比较值同计数器PW</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMC_CCR5L</name>
          <description>PWMC捕获比较寄存器5</description>
          <addressOffset>0xb0</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRC5</name>
              <description>捕获/比较5 的16 位值（n=A/C/E） CCRn5 包含了装入当前比较值（预装载值）。如果在PWMn_CCMR5 寄存器（OCn5PE 位）中未选 择预装载功能，写入的数值会立即传输至当前寄存器中。否则只有当更新事件发生时，此预装载 值才传输至当前捕获/比较5 寄存器中。当前比较值同计数器PW</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMC_CCR6H</name>
          <description>PWMC捕获比较寄存器6</description>
          <addressOffset>0xb2</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRC6</name>
              <description>捕获/比较n 的16 位值（n=A/C/E） CCRn6 包含了装入当前比较值（预装载值）。如果在PWMn_CCMR6 寄存器（OCn6PE 位）中未选 择预装载功能，写入的数值会立即传输至当前寄存器中。否则只有当更新事件发生时，此预装载 值才传输至当前捕获/比较6 寄存器中。当前比较值同计数器PW</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMC_CCR6L</name>
          <description>PWMC捕获比较寄存器6</description>
          <addressOffset>0xb3</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRC6</name>
              <description>捕获/比较n 的16 位值（n=A/C/E） CCRn6 包含了装入当前比较值（预装载值）。如果在PWMn_CCMR6 寄存器（OCn6PE 位）中未选 择预装载功能，写入的数值会立即传输至当前寄存器中。否则只有当更新事件发生时，此预装载 值才传输至当前捕获/比较6 寄存器中。当前比较值同计数器PW</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>HSPWMC</name>
      <description>高速 PWM C 配置；不访问间接窗口</description>
      <baseAddress>0x007ef970</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>HSPWMC_CFG</name>
          <description>高速PWMC配置寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>PWMC_EXTN</name>
              <description>PWMC 间接寻址的基地址选择</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>间接寻址的基地址，BASE[15:7] = 0x1f1，间接寻址范围为F880H～F8FFH</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>间接寻址的基地址，BASE[15:7] = 0x1f2，间接寻址范围为F900H～F97FH</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWMC_INTEN</name>
              <description>异步模式中断使能位（n=A/B/C/D/E/F）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭异步模式下的PWMn 中断。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能异步模式下的PWMn 中断。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWMC_ASYNCEN</name>
              <description>异步控制模式使能位（n=A/B/C/D/E/F）</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭异步控制。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能异步控制模式。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Field_1</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PWMD</name>
