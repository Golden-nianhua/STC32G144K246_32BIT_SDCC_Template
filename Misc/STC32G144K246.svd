                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>SPI 输入时钟/2</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
