          <addressOffset>0xf810215</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ADC_RES</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC_RESL</name>
          <description>ADC转换结果低位寄存器</description>
          <addressOffset>0xf810216</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ADC_RESL</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ADCCFG</name>
          <description>ADC配置寄存器</description>
          <addressOffset>0xf810236</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RESFMT</name>
              <description>ADC 转换结果格式控制位</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>转换结果左对齐。ADC_RES 保存结果的高8 位，ADC_RESL 保存结果的低4 位。格式如下：</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>转换结果右对齐。ADC_RES 保存结果的高4 位，ADC_RESL 保存结果的低8 位。格式如下：</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RESDIFF</name>
              <description>ADC 转换结果为差分格式</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>非差分格式。ADC_RES[11:0]为原始的ADC 转换结果</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>差分格式。当ADC1 和ADC2 为同步触发模式时，可将RESDIFF 设置为1，可以模拟出差分通</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SPEED</name>
              <description>设置ADC 时钟｛FADC＝SYSclk/2/(SPEED+1)｝</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>ADC2</name>
      <description>ADC2 通道、触发、时序和转换结果</description>
      <baseAddress>0x007efb38</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>ADC2_CONTR</name>
          <description>ADC2控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ADC2_POWER</name>
              <description>ADC2 电源控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭ADC2 电源</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>打开ADC2 电源。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADC2_START</name>
              <description>ADC2 转换启动控制位。写入1 后开始ADC2 转换，转换完成后硬件自动将此位清零。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>无影响。即使ADC2 已经开始转换工作，写0 也不会停止A/D 转换。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>开始ADC2 转换，转换完成后硬件自动将此位清零。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADC2_FLAG</name>
              <description>ADC2 转换完成中断请求标志。需要软件清零。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADC2_EPWMT</name>
              <description>使能PWM 实时触发ADC2 功能</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADC2_CHS</name>
              <description>ADC2 模拟通道选择位 （注意：被选择为ADC2 输入通道的I/O 口，必须设置PxM0/PxM1 寄存器将I/O 口模式设置为高阻输 入模式。另外如果MCU 进入主时钟停振/省电模式后，仍需要使能ADC2 通道，则需要设置PxIE 寄存器关闭数字输入通道，以防止外部模拟输入信号忽高忽低而产生额外</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>ADC2 通道：P0.0；ADC2_CHS[3:0]：1000；ADC2 通道：P6.0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>ADC2 通道：P0.1；ADC2_CHS[3:0]：1001；ADC2 通道：P6.1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>ADC2 通道：P0.2；ADC2_CHS[3:0]：1010；ADC2 通道：P6.2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>ADC2 通道：P0.3；ADC2_CHS[3:0]：1011；ADC2 通道：OP1O</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_4</name>
                  <description>ADC2 通道：P0.4；ADC2_CHS[3:0]：1100；ADC2 通道：OP2O</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_5</name>
                  <description>ADC2 通道：P0.5；ADC2_CHS[3:0]：1101；ADC2 通道：OP3O</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_6</name>
                  <description>ADC2 通道：P0.6；ADC2_CHS[3:0]：1110；ADC2 通道：OP4O</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_7</name>
                  <description>ADC2 通道：P0.7；ADC2_CHS[3:0]：1111；ADC2 通道：测试内部1.19V</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC2CFG</name>
