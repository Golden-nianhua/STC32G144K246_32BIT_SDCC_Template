        </register>
        <register>
          <name>PWMF_PSCRH</name>
          <description>PWMF预分频高字节</description>
          <addressOffset>0x3b</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PSCF</name>
              <description>预分频器的16 位值。（n=A/B/C/D/E/F） 预分频器用于对CK_PSC进行分频。计数器的时钟频率（fCK_CNT）等于fCK_PSC（/ PSCR[15:0]+1）。 PSCR 包含了当更新事件产生时装入当前预分频器寄存器的值（更新事件包括计数器被TIM_EGR 的UG 位清0 或被工作在</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_PSCRL</name>
          <description>PWMF预分频低字节</description>
          <addressOffset>0x3c</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PSCF</name>
              <description>预分频器的16 位值。（n=A/B/C/D/E/F） 预分频器用于对CK_PSC进行分频。计数器的时钟频率（fCK_CNT）等于fCK_PSC（/ PSCR[15:0]+1）。 PSCR 包含了当更新事件产生时装入当前预分频器寄存器的值（更新事件包括计数器被TIM_EGR 的UG 位清0 或被工作在</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_ARRH</name>
          <description>PWMF自动重装寄存器高字节</description>
          <addressOffset>0x3d</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ARRF</name>
              <description>自动重装载16 位值（n=A/B/C/D/E/F） ARR 包含了将要装载入实际的自动重装载寄存器的值。当自动重装载的值为0 时，计数器不工作。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_ARRL</name>
          <description>PWMF自动重装寄存器低字节</description>
          <addressOffset>0x3e</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ARRF</name>
              <description>自动重装载16 位值（n=A/B/C/D/E/F） ARR 包含了将要装载入实际的自动重装载寄存器的值。当自动重装载的值为0 时，计数器不工作。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_CCR5H</name>
          <description>PWMF比较捕获寄存器5高位</description>
          <addressOffset>0x40</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRF5</name>
              <description>捕获/比较n 的16 值（n=A/B/C/D/E/F，x=1/5） 若CCn 通道配置为输出：CCRn 包含了装入当前比较值（预装载值）。如果在PWMn_CCMR1 寄存 器（OCnPE 位）中未选择预装载功能，写入的数值会立即传输至当前寄存器中。否则只有当更新 事件发生时，此预装载值才传输至当前捕</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_CCR5L</name>
          <description>PWMF比较捕获寄存器5低位</description>
          <addressOffset>0x41</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRF5</name>
              <description>捕获/比较n 的16 值（n=A/B/C/D/E/F，x=1/5） 若CCn 通道配置为输出：CCRn 包含了装入当前比较值（预装载值）。如果在PWMn_CCMR1 寄存 器（OCnPE 位）中未选择预装载功能，写入的数值会立即传输至当前寄存器中。否则只有当更新 事件发生时，此预装载值才传输至当前捕</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_CCR6H</name>
          <description>PWMF比较捕获寄存器6高位</description>
          <addressOffset>0x42</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRF6</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=2/6）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_CCR6L</name>
          <description>PWMF比较捕获寄存器6低位</description>
          <addressOffset>0x43</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRF6</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=2/6）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_CCR7H</name>
          <description>PWMF比较捕获寄存器7高位</description>
          <addressOffset>0x44</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRF7</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=3/7）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_CCR7L</name>
          <description>PWMF比较捕获寄存器7低位</description>
          <addressOffset>0x45</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRF7</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=3/7）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_CCR8H</name>
          <description>PWMF比较捕获寄存器8高位</description>
          <addressOffset>0x46</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRF8</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=4/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_CCR8L</name>
          <description>PWMF比较捕获寄存器8低位</description>
          <addressOffset>0x47</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRF8</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=4/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMF_BKR</name>
          <description>PWMF刹车寄存器</description>
          <addressOffset>0x48</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>MOEF</name>
              <description>主输出使能。一旦刹车输入有效，该位被硬件异步清0。根据AOE 位的设置值，该位可以由软 件置1 或被自动置1。它仅对配置为输出的通道有效。（n=A/B/C/D/E/F）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止OC 和OCN 输出或强制为空闲状态</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>如果设置了相应的使能位（PWMn_CCERX 寄存器的CCIE 位），则使能OC 和OCN 输出。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AOEF</name>
              <description>自动输出使能（n=A/B/C/D/E/F）</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>MOE 只能被软件置1；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>MOE 能被软件置1 或在下一个更新事件被自动置1（如果刹车输入无效）。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BKPF</name>
              <description>刹车输入极性（n=A/B/C/D/E/F）</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>刹车输入低电平有效</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>刹车输入高电平有效</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BKEF</name>
              <description>刹车功能使能（n=A/B/C/D/E/F）</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止刹车输入（BRK）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>开启刹车输入（BRK）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OSSRF</name>
              <description>运行模式下“关闭状态”选择。该位在MOE=1 且通道设为输出时有效（n=A/B/C/D/E/F）</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当PWM 不工作时，禁止OC/OCN 输出（OC/OCN 使能输出信号=0）；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当 PWM 不工作时，一旦 CCiE=1 或 CCiNE=1，首先开启 OC/OCN 并输出无效电平，然后置</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OSSIF</name>
              <description>空闲模式下“关闭状态”选择。该位在MOE=0 且通道设为输出时有效。（n=A/B/C/D/E/F）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当PWM 不工作时，禁止OC/OCN 输出（OC/OCN 使能输出信号=0）；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当PWM 不工作时，一旦CCiE=1 或CCiNE=1，OC/OCN 首先输出其空闲电平，然后 OC/OCN</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOCKF</name>
              <description>锁定设置。该位为防止软件错误而提供的写保护措施（n=A/B/C/D/E/F）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>保护级别：无保护；保护内容：寄存器无写保护</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>保护级别：锁定级别1；保护内容：不能写入PWMn_BKR寄存器的MOE、BKE、BKP、AOE位和PWMn_OISR寄存器的OISI位</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>保护级别：锁定级别2；保护内容：不能写入锁定级别1中的各位，也不能写入CC极性位以及OSSR/OSSI位</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>保护级别：锁定级别3；保护内容：不能写入锁定级别2中的各位，也不能写入CC控制位</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>HSPWMF</name>
      <description>高速 PWM F 配置；不访问间接窗口</description>
      <baseAddress>0x007ef68c</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>HSPWMF_CFG</name>
          <description>高速PWMF配置寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>PWMF_INTEN</name>
              <description>异步模式中断使能位（n=A/B/C/D/E/F）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭异步模式下的PWMn 中断。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能异步模式下的PWMn 中断。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWMF_ASYNCEN</name>
              <description>异步控制模式使能位（n=A/B/C/D/E/F）</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭异步控制。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能异步控制模式。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Field_1</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>USB</name>
      <description>USB 2.0 FS 直接控制和时钟；端点寄存器为间接索引</description>
      <baseAddress>0x100000dc</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x18</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>USBCLK</name>
          <description>USB时钟控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ENCKM</name>
              <description>PLL 倍频控制</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止PLL 倍频</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能PLL 倍频</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PCKI</name>
              <description>PLL 时钟选择</description>
              <bitOffset>5</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>/1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>/2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>/4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>/8</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CRE</name>
              <description>时钟追频控制位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止时钟追频</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能时钟追频</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TST_USB</name>
              <description>USB 测试模式</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止USB 测试模式</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能USB 测试模式</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TST_PHY</name>
              <description>PHY 测试模式</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止PHY 测试模式</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能PHY 测试模式</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PHYTST</name>
              <description>USB PHY 测试</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>方式：方式0：正常；DP：x；DM：x</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>方式：方式1：强制“1”；DP：1；DM：0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>方式：方式2：强制“0”；DP：0；DM：1</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>方式：方式3：强制单端“0”；DP：0；DM：0</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>USBCON</name>
          <description>USB控制寄存器</description>
          <addressOffset>0x18</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ENUSB</name>
              <description>USB 功能与USB 时钟控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭USB 功能与USB 时钟</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能USB 功能与USB 时钟</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ENUSBRST</name>
              <description>USB 复位设置控制位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭USB 复位设置</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能USB 复位</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PS2M</name>
              <description>PS2 mode 功能控制位</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭PS2 mode 功能</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能PS2 mode 功能</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PUEN</name>
              <description>DP/DM 端口上1.5K 上拉电阻控制位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止上拉电阻</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能上拉电阻</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PDEN</name>
              <description>DP/DM 端口上500K 下拉电阻控制位</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止下拉电阻</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能下拉电阻</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DFREC</name>
              <description>差分接收状态位（只读）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当前DP/DM 的差分状态为“0”</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当前DP/DM 的差分状态为“1”</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DP</name>
              <description>D+端口状态（PS2 为0 时只读，PS2 为1 时可读写）</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当前D+为逻辑0 电平</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当前D+为逻辑1 电平</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DM</name>
              <description>D-端口状态（PS2 为0 时只读，PS2 为1 时可读写）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当前D-为逻辑0 电平</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当前D-为逻辑1 电平</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TFT</name>
      <description>TFT 8080/6800 总线接口控制和状态</description>
      <baseAddress>0x007efe50</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x6</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>LCMIFCFG</name>
          <description>LCM接口配置寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>LCMIFIE</name>
              <description>TFT彩屏接口中断允许位。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止TFT 彩屏接口中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许TFT 彩屏接口中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LCMIFIP</name>
              <description>TFT彩屏接口中断优先级控制位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>最低级（0）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>较低级（1）</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>较高级（2）</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>最高级（3）</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LCMIFDPS</name>
              <description>TFT 彩屏接口数据脚选择位</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>D16_D8：1；数据高字节DAT[15:8]：P2[7:0]；数据低字节DAT[7:0]：P0[7:0]</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>D16_D8：1；数据高字节DAT[15:8]：P6[7:0]；数据低字节DAT[7:0]：P2[7:0]</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>D16_D8：1；数据高字节DAT[15:8]：P2[7:0]；数据低字节DAT[7:0]：{P0[7:4],P4[7],P4[6],P4[3],P4[1]}</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>D16_D8：1；数据高字节DAT[15:8]：P6[7:0]；数据低字节DAT[7:0]：P7[7:0]</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>D16_D8</name>
              <description>TFT 彩屏接口数据宽度控制位</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>8 位数据宽度</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>16 位数据宽度</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>M68_I80</name>
              <description>TFT 彩屏接口模式选择位</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>i8080 模式</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>M6800 模式</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>LCMIFCFG2</name>
          <description>LCM接口配置寄存器2</description>
          <addressOffset>0x1</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>LCMIFCPS</name>
              <description>TFT 彩屏接口控制脚选择位</description>
              <bitOffset>5</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>RS：P4.5；i8080 的读信号RDM6800 的使能信号E：P4.4；i8080 的写信号WRM6800 的读写信号RW：P4.2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>RS：P4.5；i8080 的读信号RDM6800 的使能信号E：P3.7；i8080 的写信号WRM6800 的读写信号RW：P3.6</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>RS：P4.0；i8080 的读信号RDM6800 的使能信号E：P4.4；i8080 的写信号WRM6800 的读写信号RW：P4.2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>RS：P4.0；i8080 的读信号RDM6800 的使能信号E：P3.7；i8080 的写信号WRM6800 的读写信号RW：P3.6</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SETUPT</name>
              <description>TFT 彩屏接口通讯的数据建立时间控制位（详见后续章节的时序图）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>HOLDT</name>
              <description>TFT 彩屏接口通讯的数据保持时间控制位（详见后续章节的时序图）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LCMIFCR</name>
          <description>LCM接口控制寄存器</description>
          <addressOffset>0x2</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ENLCMIF</name>
              <description>TFT 彩屏接口使能控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止TFT 彩屏接口功能</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许TFT 彩屏接口功能</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CMD</name>
              <description>TFT 彩屏接口触发命令</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_4</name>
                  <description>写命令</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_5</name>
                  <description>写数据</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_6</name>
                  <description>读命令/状态</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_7</name>
                  <description>读数据</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>LCMIFSTA</name>
          <description>LCM接口状态寄存器</description>
          <addressOffset>0x3</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>LCMIFIF</name>
              <description>TFT彩屏接口中断请求标志。需要软件清零。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LCMIFPSCR</name>
          <description>LCM接口时钟预分配寄存器</description>
          <addressOffset>0x6</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>LCMIFPSCR</name>
              <description>LCMIF 预分频器。预分频器用于对系统时钟进行预分频，分频后的时钟提供给LCMIF 模块。 LCMIF 时钟频率＝SYSclk /（LCMIFPSCR[7:0]+1）。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
