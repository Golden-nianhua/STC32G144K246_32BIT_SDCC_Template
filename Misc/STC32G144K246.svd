                <enumeratedValue>
                  <name>Value_1</name>
                  <description>2（默认值）</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>3</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>4</description>
                  <value>3</value>
