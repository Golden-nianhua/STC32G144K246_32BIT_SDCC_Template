                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能异步模式下的PWMn 中断。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWMB_ASYNCEN</name>
              <description>异步控制模式使能位（n=A/B/C/D/E/F）</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭异步控制。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能异步控制模式。</description>
                  <value>1</value>
                </enumeratedValue>
