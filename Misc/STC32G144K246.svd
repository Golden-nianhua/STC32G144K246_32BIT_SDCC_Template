                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>SYSclk波特率=𝟑𝟐</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
