          </fields>
        </register>
        <register>
          <name>TM1PS</name>
          <description>定时器1时钟预分频寄存器</description>
          <addressOffset>0x1</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
