            </field>
            <field>
              <name>SMPDUTY</name>
              <description>ADC 模拟信号采样时间控制Tduty（注意：SMPDUTY 一定不能设置小于01010B）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
