          </fields>
        </register>
        <register>
          <name>AUXR</name>
          <description>辅助寄存器1</description>
          <addressOffset>0xf8101ee</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>T0x12</name>
              <description>定时器0速度控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>12T 模式，即CPU 时钟12 分频（FOSC/12）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>1T 模式，即CPU 时钟不分频分频（FOSC/1）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T1x12</name>
              <description>定时器1速度控制位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>12T 模式，即CPU 时钟12 分频（FOSC/12）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>1T 模式，即CPU 时钟不分频分频（FOSC/1）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UART_M0x6</name>
              <description>串口1 模式0 的通讯速度控制</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>串口1 模式0 的波特率不加倍，固定为Fosc/12</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>串口1 模式0 的波特率6 倍速，即固定为Fosc/12*6 ＝ Fosc/2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T2R</name>
              <description>定时器2的运行控制位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>定时器2 停止计数</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>定时器2 开始计数</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T2_C_T</name>
              <description>控制定时器2用作定时器或计数器，清0则用作定时器（对内部系统时钟进行计数），置1用作</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>T2x12</name>
              <description>定时器2速度控制位</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>12T 模式，即CPU 时钟12 分频（FOSC/12）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>1T 模式，即CPU 时钟不分频分频（FOSC/1）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXTRAM</name>
              <description>片外用户实际扩展的XRAM 访问控制</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>可以访问内部扩展的XRAM，不能访问用户实际在外部用并行总线扩展的XRAM 或外设，这部分用</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>禁止访问内部扩展的XRAM，可以访问用户实际在外部用并行总线扩展的XRAM 或外设，这部分用</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S1BRT</name>
              <description>串口1 波特率发生器选择位</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>选择定时器1 作为波特率发生器</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>选择定时器2 作为波特率发生器（默认值）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
