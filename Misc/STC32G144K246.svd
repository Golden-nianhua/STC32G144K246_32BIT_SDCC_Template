                <enumeratedValue>
                  <name>Value_1</name>
                  <description>串口7 中断优先级为1 级（较低级）</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>串口7 中断优先级为2 级（较高级）</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>串口7 中断优先级为3 级（最高级）</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
