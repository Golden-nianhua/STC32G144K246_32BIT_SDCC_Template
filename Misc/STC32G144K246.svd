<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.3">
  <vendor>STC</vendor>
  <name>STC32G144K246</name>
  <version>2.0</version>
  <description>STC32G144K246 芯片级外设视图：主要配置、状态与计数器。</description>
  <addressUnitBits>8</addressUnitBits>
  <width>8</width>
  <size>8</size>
  <peripherals>
    <peripheral>
      <name>Clock</name>
      <description>时钟源、分频、振荡器和 PLL</description>
      <baseAddress>0x007efe00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x6</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x7</offset>
        <size>0x2</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xc</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xf81029d</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CLKSEL</name>
          <description>时钟选择寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MCK2SEL</name>
              <description>主时钟源选择</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>MCKSEL 选择的时钟源</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>内部HPLL1 输出/2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>内部HPLL2 输出/2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>内部48MHz 高速IRC</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MCKSEL</name>
              <description>主时钟源选择</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>内部高精度IRC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>外部高速晶振</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>外部32KHz 晶振</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>内部32KHz 低速IRC</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CLKDIV</name>
          <description>时钟分频寄存器</description>
          <addressOffset>0x1</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CLKDIV</name>
              <description>主时钟分频系数。系统时钟SYSCLK 是对主时钟MCLK 进行分频后的时钟信号。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>HIRCCR</name>
          <description>内部高速振荡器控制寄存器</description>
          <addressOffset>0x2</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENHIRC</name>
              <description>内部高速高精度IRC 使能位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭内部高精度IRC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能内部高精度IRC</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MCLKO_CKS</name>
              <description>时钟输出的时钟源选择（此位只写）</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭主时钟输出</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>输出系统时钟</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>输出内部高速HIRC 时钟</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>输出滤波后的内部高速HIRC 时钟</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HIRCST</name>
              <description>内部高速高精度IRC 频率稳定标志位。（只读位） 当内部的IRC 从停振状态开始使能后，必须经过一段时间，振荡器的频率才会稳定，当振荡器频率 稳定后，时钟控制器会自动将HIRCST 标志位置1。所以当用户程序需要将时钟切换到使用内部IRC 时，首先必须设置ENHIRC=1 使能振荡器，然后一直查询振</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>XOSCCR</name>
          <description>外部晶振控制寄存器</description>
          <addressOffset>0x3</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENXOSC</name>
              <description>外部晶体振荡器使能位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭外部晶体振荡器</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能外部晶体振荡器</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>XITYPE</name>
              <description>外部时钟源类型</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>外部时钟源是外部时钟信号（或有源晶振）。信号源只需连接单片机的XTALI（P1.7），此时P1.6</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>外部时钟源是晶体振荡器。信号源连接单片机的XTALI（P1.7）和XTALO（P1.6）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GAIN</name>
              <description>外部晶体振荡器振荡增益控制位</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭振荡增益（低增益）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能振荡增益（高增益）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>XCFILTER</name>
              <description>外部晶体振荡器抗干扰控制寄存器</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>XOSCST</name>
              <description>外部晶体振荡器频率稳定标志位。（只读位） 当外部晶体振荡器从停振状态开始使能后，必须经过一段时间，振荡器的频率才会稳定，当振荡器 频率稳定后，时钟控制器会自动将XOSCST 标志位置1。所以当用户程序需要将时钟切换到使用外 部晶体振荡器时，首先必须设置ENXOSC=1 使能振荡器，然后一直查询振荡器</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IRC32KCR</name>
          <description>内部低速振荡器控制寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENIRC32K</name>
              <description>内部低速IRC 使能位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭内部低速IRC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能内部低速IRC</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IRC32KST</name>
              <description>内部低速IRC 频率稳定标志位。（只读位） 当内部低速IRC 从停振状态开始使能后，必须经过一段时间，振荡器的频率才会稳定，当振荡器频 率稳定后，时钟控制器会自动将IRC32KST 标志位置1。所以当用户程序需要将时钟切换到使用内 部低速IRC 时，首先必须设置ENIRC32K=1 使能振荡器，然后</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MCLKOCR</name>
          <description>主时钟输出控制寄存器</description>
          <addressOffset>0x5</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MCLKO_S</name>
              <description>系统时钟输出管脚选择</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>系统时钟分频输出到P5.4 口</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>系统时钟分频输出到P1.6 口</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MCLKODIV</name>
              <description>主时钟输出分频系数</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IRC48MCR</name>
          <description>内部48M振荡器控制寄存器</description>
          <addressOffset>0x7</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENIRC48M</name>
              <description>内部48M 高速IRC 使能位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭内部48M 高速IRC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能内部48M 高速IRC</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IRC48MST</name>
              <description>内部48M 高速IRC 频率稳定标志位。（只读位） 当内部48M 高速IRC 从停振状态开始使能后，必须经过一段时间，振荡器的频率才会稳定，当振荡 器频率稳定后，时钟控制器会自动将IRC48MST 标志位置1。所以当用户程序需要将时钟切换到使 用内部48M 高速IRC 时，首先必须设置ENIRC48</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>X32KCR</name>
          <description>外部32K晶振控制寄存器</description>
          <addressOffset>0x8</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENX32K</name>
              <description>外部32K 晶体振荡器使能位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭外部32K 晶体振荡器</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能外部32K 晶体振荡器</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GAIN32K</name>
              <description>外部32K 晶体振荡器振荡增益控制位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭32K 振荡增益（低增益）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能32K 振荡增益（高增益）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>X32KST</name>
              <description>外部32K 晶体振荡器频率稳定标志位。（只读位）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>HPLLCR</name>
          <description>高速PLL控制寄存器</description>
          <addressOffset>0xc</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENHPLL</name>
              <description>高速PLL 使能位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭HPLL</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能HPLL</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSI2SCK</name>
              <description>两组高速I2S 时钟选择</description>
              <bitOffset>5</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>HPLLCKS</name>
              <description>高速PLL 输入时钟源选择</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>内部基本时钟（BASECLK）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>内部48M 的IRC 时钟</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HPLLDIV</name>
              <description>高速PLL 锁频的除频数（倍频数）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>HPLLPDIV</name>
          <description>高速PLL预分频寄存器</description>
          <addressOffset>0xd</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>HPLL_PREDIV</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>HPLL2CR</name>
          <description>高速PLL2控制寄存器</description>
          <addressOffset>0xe</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENHPLL2</name>
              <description>高速PLL2 使能位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭HPLL2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能HPLL2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSIOCK</name>
              <description>两组高速外设时钟选择</description>
              <bitOffset>5</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>HPLL2CKS</name>
              <description>高速PLL2 输入时钟源选择</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>内部基本时钟（BASECLK）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>内部48M 的IRC 时钟</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HPLL2DIV</name>
              <description>高速PLL2 锁频的除频数（倍频数）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>HPLL2PDIV</name>
          <description>高速PLL2预分频寄存器</description>
          <addressOffset>0xf</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>HPLL2_PREDIV</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IRCBAND</name>
          <description>IRC频段选择检测</description>
          <addressOffset>0xf81029d</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>USBCKS</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>USBCKS2</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SEL</name>
              <description>频段选择</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>选择10MHz 频段</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>选择27MHz 频段</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>选择44MHz 频段</description>
                  <value>2</value>
