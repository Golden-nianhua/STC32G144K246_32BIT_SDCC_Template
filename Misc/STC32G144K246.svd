              <name>PSC</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_PSCRL</name>
          <description>PWMA预分频低字节</description>
          <addressOffset>0x591</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PSCA</name>
              <description>预分频器的16 位值。（n=A/B/C/D/E/F） 预分频器用于对CK_PSC进行分频。计数器的时钟频率（fCK_CNT）等于fCK_PSC（/ PSCR[15:0]+1）。 PSCR 包含了当更新事件产生时装入当前预分频器寄存器的值（更新事件包括计数器被TIM_EGR 的UG 位清0 或被工作在</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_ARRH</name>
          <description>PWMA自动重装寄存器高字节</description>
          <addressOffset>0x592</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ARRA</name>
              <description>自动重装载16 位值（n=A/B/C/D/E/F） ARR 包含了将要装载入实际的自动重装载寄存器的值。当自动重装载的值为0 时，计数器不工作。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_ARRL</name>
          <description>PWMA自动重装寄存器低字节</description>
          <addressOffset>0x593</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ARRA</name>
              <description>自动重装载16 位值（n=A/B/C/D/E/F） ARR 包含了将要装载入实际的自动重装载寄存器的值。当自动重装载的值为0 时，计数器不工作。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_CCR1H</name>
          <description>PWMA比较捕获寄存器1高位</description>
          <addressOffset>0x595</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRA1</name>
              <description>捕获/比较n 的16 值（n=A/B/C/D/E/F，x=1/5） 若CCn 通道配置为输出：CCRn 包含了装入当前比较值（预装载值）。如果在PWMn_CCMR1 寄存 器（OCnPE 位）中未选择预装载功能，写入的数值会立即传输至当前寄存器中。否则只有当更新 事件发生时，此预装载值才传输至当前捕</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_CCR1L</name>
          <description>PWMA比较捕获寄存器1低位</description>
          <addressOffset>0x596</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRA1</name>
              <description>捕获/比较n 的16 值（n=A/B/C/D/E/F，x=1/5） 若CCn 通道配置为输出：CCRn 包含了装入当前比较值（预装载值）。如果在PWMn_CCMR1 寄存 器（OCnPE 位）中未选择预装载功能，写入的数值会立即传输至当前寄存器中。否则只有当更新 事件发生时，此预装载值才传输至当前捕</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_CCR2H</name>
          <description>PWMA比较捕获寄存器2高位</description>
          <addressOffset>0x597</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRA2</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=2/6）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_CCR2L</name>
          <description>PWMA比较捕获寄存器2低位</description>
          <addressOffset>0x598</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRA2</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=2/6）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_CCR3H</name>
          <description>PWMA比较捕获寄存器3高位</description>
          <addressOffset>0x599</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRA3</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=3/7）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_CCR3L</name>
          <description>PWMA比较捕获寄存器3低位</description>
          <addressOffset>0x59a</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRA3</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=3/7）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_CCR4H</name>
          <description>PWMA比较捕获寄存器4高位</description>
          <addressOffset>0x59b</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRA4</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=4/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_CCR4L</name>
          <description>PWMA比较捕获寄存器4低位</description>
          <addressOffset>0x59c</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CCRA4</name>
              <description>捕获/比较n 的16 位值（n=A/B/C/D/E/F，x=4/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PWMA_BKR</name>
          <description>PWMA刹车寄存器</description>
          <addressOffset>0x59d</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>MOEA</name>
              <description>主输出使能。一旦刹车输入有效，该位被硬件异步清0。根据AOE 位的设置值，该位可以由软 件置1 或被自动置1。它仅对配置为输出的通道有效。（n=A/B/C/D/E/F）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止OC 和OCN 输出或强制为空闲状态</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>如果设置了相应的使能位（PWMn_CCERX 寄存器的CCIE 位），则使能OC 和OCN 输出。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AOEA</name>
              <description>自动输出使能（n=A/B/C/D/E/F）</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>MOE 只能被软件置1；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>MOE 能被软件置1 或在下一个更新事件被自动置1（如果刹车输入无效）。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BKPA</name>
              <description>刹车输入极性（n=A/B/C/D/E/F）</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>刹车输入低电平有效</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>刹车输入高电平有效</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BKEA</name>
              <description>刹车功能使能（n=A/B/C/D/E/F）</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止刹车输入（BRK）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>开启刹车输入（BRK）</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OSSRA</name>
              <description>运行模式下“关闭状态”选择。该位在MOE=1 且通道设为输出时有效（n=A/B/C/D/E/F）</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当PWM 不工作时，禁止OC/OCN 输出（OC/OCN 使能输出信号=0）；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当 PWM 不工作时，一旦 CCiE=1 或 CCiNE=1，首先开启 OC/OCN 并输出无效电平，然后置</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OSSIA</name>
              <description>空闲模式下“关闭状态”选择。该位在MOE=0 且通道设为输出时有效。（n=A/B/C/D/E/F）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当PWM 不工作时，禁止OC/OCN 输出（OC/OCN 使能输出信号=0）；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当PWM 不工作时，一旦CCiE=1 或CCiNE=1，OC/OCN 首先输出其空闲电平，然后 OC/OCN</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOCKA</name>
              <description>锁定设置。该位为防止软件错误而提供的写保护措施（n=A/B/C/D/E/F）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>保护级别：无保护；保护内容：寄存器无写保护</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>保护级别：锁定级别1；保护内容：不能写入PWMn_BKR寄存器的MOE、BKE、BKP、AOE位和PWMn_OISR寄存器的OISI位</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>保护级别：锁定级别2；保护内容：不能写入锁定级别1中的各位，也不能写入CC极性位以及OSSR/OSSI位</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>保护级别：锁定级别3；保护内容：不能写入锁定级别2中的各位，也不能写入CC控制位</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>HSPWMA</name>
      <description>高速 PWM A 配置；不访问间接窗口</description>
      <baseAddress>0x007efbf0</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
