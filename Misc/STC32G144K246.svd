    </peripheral>
    <peripheral>
      <name>ClockCalibration</name>
      <description>内部 IRC 校准与追频</description>
      <baseAddress>0x007efda8</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x5</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CRECR</name>
          <description>CRE控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ENCRE</name>
              <description>CRE模块控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭CRE 模块。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能CRE 模块。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MONO</name>
              <description>自动校准步幅控制</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>单步模式。每个校准周期，硬件自动将IRTRIM 递增或递减1。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>双步模式。每个校准周期，硬件自动将IRTRIM 递增或递减2。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UPT</name>
              <description>CRE 校准周期选择</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>1ms</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>4ms</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>32ms</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>64ms</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CREHF</name>
              <description>高频模式选择</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>低频模式（目标频率小于或等于50MHz）。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>高频模式（目标频率大于50MHz）。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CREINC</name>
              <description>CRE校准正处于上调状态。只读位。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CREDEC</name>
              <description>CRE校准正处于下调状态。只读位。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CRERDY</name>
              <description>CRE校准完成状态。只读位。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>CRE 校准功能未启动或者未校准完成。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>CRE 校准已完成。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CRECNTH</name>
          <description>CRE校准目标寄存器</description>
          <addressOffset>0x1</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>CNT</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CRECNTL</name>
          <description>CRE校准目标寄存器</description>
          <addressOffset>0x2</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>CNT</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CRERES</name>
          <description>CRE分辨率控制寄存器</description>
          <addressOffset>0x3</addressOffset>
          <size>8</size>
          <access>read-only</access>
        </register>
        <register>
          <name>CRECFG</name>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <access>read-only</access>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PowerReset</name>
      <description>电源管理、低压和复位来源</description>
      <baseAddress>0x007efe99</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xf8101ee</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xf810266</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>RSTFLAG</name>
          <description>复位标志寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>LVDRSTF</name>
              <description>LVD 低压复位标志 读0：无意义 读1：当前的复位是由LVD 低压复位所触发（上电复位默认值为1） 写0：无效果 写1：清除LVDRST 标志位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WDTRSTF</name>
              <description>看门狗复位标志 读0：无意义（上电复位默认值为0） 读1：当前的复位是由看门狗溢出所触发 写0：无效果 写1：清除WDTRST 标志位</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWRSTF</name>
              <description>软复位标志 读0：无意义 读1：当前的复位是由软件写SWRST（IAP_CONTR.5）所触发（用户程序复位默认值为1） 写0：无效果 写1：清除SWRST 标志位</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ROMOVF</name>
              <description>代码区溢出标志 读0：无意义（上电复位默认值为0） 读1：当前的复位是由于CPU 执行代码到非程序区导致的代码区溢出所触发 写0：无效果 写1：清除ROMOV 标志位</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXRSTF</name>
              <description>外部复位标志 读0：无意义（上电复位默认值为0） 读1：当前的复位是外部复位脚（P5.4/RST）被拉低所触发 写0：无效果 写1：清除EXRST 标志位</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PCON</name>
          <description>电源控制寄存器</description>
          <addressOffset>0xf8101ee</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>SMOD</name>
              <description>串口1 波特率控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>SYSclk波特率=𝟔𝟒</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>SYSclk波特率=𝟑𝟐</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SMOD0</name>
              <description>帧错误检测控制位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>无帧错检测功能</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能帧错误检测功能。此时SCON 的SM0/FE 为FE 功能，即为帧错误检测标志位。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LVDF</name>
              <description>低压检测标志位。当系统检测到低压事件时，硬件自动将此位置1，此位需要用户软件清零。 LVD 低压检测有低压检测门槛电压可选： 2.0V/2.4V/2.7V/3.0V，误差±1%。 LVD 低压检测在ISP 烧录时默认设置是低压即复位。 当允许LVD 低压检测复位，并且电压低到指定的LVD 复位门槛电</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>POF</name>
              <description>上电复位标志位。上电复位硬件自动置1。需要软件清0，硬件不会自动清0。 当 MCU-Vcc 电压 低于1.65V±10% 以下时，STC8/STC32/AI8051U 系列 MCU 都会掉电复位。 当 MCU-Vcc 电压从低于 1.65V±10% 以下往上爬升，电压爬升到比1.65V 高后， 硬件</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GF1</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GF0</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PD</name>
              <description>主时钟停振/省电模式控制位</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>无影响</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>单片机进入主时钟停振/省电模式，CPU 以及全部外设均停止工作。唤醒后硬件自动清零。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IDL</name>
              <description>IDLE（空闲）模式控制位</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>无影响</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>单片机进入IDLE 模式，只有CPU 停止工作，其他外设依然在运行。唤醒后硬件自动清零</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RSTCFG</name>
          <description>复位配置寄存器</description>
          <addressOffset>0xf810266</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ENLVR</name>
              <description>低压复位控制位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止低压复位。当系统检测到低压事件时，会产生低压中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能低压复位。当系统检测到低压事件时，自动复位</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>P54RST</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LVDS</name>
              <description>低压检测门槛电压设置</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>2.0V</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>2.4V</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>2.7V</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>3.0V</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>Watchdog</name>
      <description>看门狗</description>
      <baseAddress>0x100000c1</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>WDT_CONTR</name>
          <description>看门狗控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>WDT_FLAG</name>
              <description>看门狗溢出标志 看门狗发生溢出时，硬件自动将此位置1，需要软件清零。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EN_WDT</name>
              <description>看门狗使能位</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>对单片机无影响</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>启动看门狗定时器</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLR_WDT</name>
              <description>看门狗定时器清零</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>对单片机无影响</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>清零看门狗定时器，硬件自动将此位复位</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IDL_WDT</name>
              <description>IDLE 模式时的看门狗控制位</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>IDLE 模式时看门狗停止计数</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>IDLE 模式时看门狗继续计数</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WDT_PS</name>
              <description>看门狗定时器时钟分频系数</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>分频系数：2；12M 主频时的溢出时间：≈ 65.5 毫秒；20M 主频时的溢出时间：≈ 39.3 毫秒</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>分频系数：4；12M 主频时的溢出时间：≈ 131 毫秒；20M 主频时的溢出时间：≈ 78.6 毫秒</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>分频系数：8；12M 主频时的溢出时间：≈ 262 毫秒；20M 主频时的溢出时间：≈ 157 毫秒</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>分频系数：16；12M 主频时的溢出时间：≈ 524 毫秒；20M 主频时的溢出时间：≈ 315 毫秒</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_4</name>
                  <description>分频系数：32；12M 主频时的溢出时间：≈ 1.05 秒；20M 主频时的溢出时间：≈ 629 毫秒</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_5</name>
                  <description>分频系数：64；12M 主频时的溢出时间：≈ 2.10 秒；20M 主频时的溢出时间：≈ 1.26 秒</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_6</name>
                  <description>分频系数：128；12M 主频时的溢出时间：≈ 4.20 秒；20M 主频时的溢出时间：≈ 2.52 秒</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_7</name>
                  <description>分频系数：256；12M 主频时的溢出时间：≈ 8.39 秒；20M 主频时的溢出时间：≈ 5.03 秒</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WakeTimer</name>
      <description>掉电唤醒定时器</description>
      <baseAddress>0x100000aa</baseAddress>
