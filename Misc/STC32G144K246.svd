                <enumeratedValue>
                  <name>Value_0</name>
                  <description>此区域为数据区域，可读、可写、不可运行代码</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>此区域为程序区域，可读、可运行代码、不可写</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T1M</name>
              <description>保留</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>T0M</name>
              <description>保留</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CKCON</name>
              <description>外部数据总线时钟控制寄存器（上电复位值为7，强烈建议上电初始化为0）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
