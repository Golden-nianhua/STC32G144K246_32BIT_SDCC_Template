                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能帧错误检测功能。此时S4CON 的S4SM0/FE 为FE 功能，即为帧错误检测标志位。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S4M0x6</name>
