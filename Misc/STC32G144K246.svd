                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>2（默认值）</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>3</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>4</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADC2_SMPDUTY</name>
              <description>ADC2模拟信号采样时间控制Tduty（注意：SMPDUTY一定不能设置小于01010B）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
