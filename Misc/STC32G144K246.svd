                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>自动触发源：定时器17自动触发；触发说明：</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>自动触发源：定时器18自动触发；触发说明：</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>自动触发源：连续触发模式；触发说明：</description>
                  <value>3</value>
