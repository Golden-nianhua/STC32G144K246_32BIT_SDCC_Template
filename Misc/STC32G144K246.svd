        </register>
        <register>
          <name>ADCEXCFG2</name>
          <description>ADC扩展配置寄存器2</description>
          <addressOffset>0x7</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>TRIGON</name>
              <description>两组ADC 同步触发控制</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>两组ADC 为各自独立工作模式</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>两组ADC 为同步模式</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWMSEL</name>
              <description>PWM 触发信号配置</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ADC_TRIGSEL</name>
              <description>选择ADC 触发源（必须使能ADC_EPWMT，触发源才有效）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>PWMA_TA</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>PWMC_TA</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>PWME_TA</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>PWMA_TA2</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_4</name>
                  <description>PWMC_TA2</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_5</name>
                  <description>PWME_TA2</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_6</name>
                  <description>PWMB_TA</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_7</name>
                  <description>PWMD_TA</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_8</name>
                  <description>PWMF_TA</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_9</name>
                  <description>1</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_10</name>
                  <description>0</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_11</name>
                  <description>PWMA_TA</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_12</name>
                  <description>TIMER17 OV</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_13</name>
                  <description>TIMER18 OV</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_14</name>
                  <description>TIMER17 OV phase 180</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_15</name>
                  <description>TIMER18 OV phase 180</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC_CONTR</name>
          <description>ADC控制寄存器</description>
          <addressOffset>0xf810214</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ADC_POWER</name>
              <description>ADC 电源控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭ADC 电源</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>打开ADC 电源。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADC_START</name>
              <description>ADC 转换启动控制位。写入1 后开始ADC 转换，转换完成后硬件自动将此位清零。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>无影响。即使ADC 已经开始转换工作，写0 也不会停止A/D 转换。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>开始ADC 转换，转换完成后硬件自动将此位清零。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADC_FLAG</name>
              <description>ADC 转换完成中断请求标志。需要软件清零。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADC_EPWMT</name>
              <description>使能PWM 实时触发ADC 功能。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADC_CHS</name>
              <description>ADC 模拟通道选择位 （注意：被选择为ADC 输入通道的I/O 口，必须设置PxM0/PxM1 寄存器将I/O 口模式设置为高阻输 入模式。另外如果MCU 进入主时钟停振/省电模式后，仍需要使能ADC 通道，则需要设置PxIE 寄 存器关闭数字输入通道，以防止外部模拟输入信号忽高忽低而产生额外的功</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>ADC 通道：P1.0；ADC_CHS[3:0]：1000；ADC 通道：P0.0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>ADC 通道：P1.1；ADC_CHS[3:0]：1001；ADC 通道：P0.1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>ADC 通道：P1.2；ADC_CHS[3:0]：1010；ADC 通道：P0.2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>ADC 通道：P1.3；ADC_CHS[3:0]：1011；ADC 通道：OP1O</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_4</name>
                  <description>ADC 通道：P1.4；ADC_CHS[3:0]：1100；ADC 通道：OP2O</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_5</name>
                  <description>ADC 通道：P1.5；ADC_CHS[3:0]：1101；ADC 通道：OP3O</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_6</name>
                  <description>ADC 通道：P1.6；ADC_CHS[3:0]：1110；ADC 通道：OP4O</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_7</name>
                  <description>ADC 通道：P1.7；ADC_CHS[3:0]：1111；ADC 通道：测试内部1.19V</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC_RES</name>
