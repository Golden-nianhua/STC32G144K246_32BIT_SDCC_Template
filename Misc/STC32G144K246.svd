      <addressBlock>
        <offset>0x7</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xf810214</offset>
        <size>0x3</size>
        <usage>registers</usage>
      </addressBlock>
