          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>PWMA_EXTN</name>
              <description>PWMA 间接寻址的基地址选择</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>间接寻址的基地址，BASE[15:7] = 0x1fd，间接寻址范围为FE80H～FEFFH</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>间接寻址的基地址，BASE[15:7] = 0x1f2，间接寻址范围为F900H～F97FH</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWMA_INTEN</name>
              <description>异步模式中断使能位（n=A/B/C/D/E/F）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭异步模式下的PWMn 中断。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能异步模式下的PWMn 中断。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWMA_ASYNCEN</name>
              <description>异步控制模式使能位（n=A/B/C/D/E/F）</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭异步控制。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能异步控制模式。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Field_1</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
