              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CCE3E</name>
              <description>OCn 输入捕获/比较输出使能。参考CCA1E（n=A/B/C/D/E/F，x=3/4/7/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
