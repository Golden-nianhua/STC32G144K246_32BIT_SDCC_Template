    <peripheral>
      <name>MemoryBus</name>
      <description>Flash 等待周期、片内 RAM 总线与缓存相关控制</description>
      <baseAddress>0x100000a1</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x48</offset>
        <size>0x2</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>BUS_SPEED</name>
          <description>总线速度控制寄存器</description>
          <addressOffset>0x0</addressOffset>
