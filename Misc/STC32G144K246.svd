            </field>
          </fields>
        </register>
        <register>
          <name>TCON</name>
          <description>定时器控制寄存器</description>
          <addressOffset>0xf8101e8</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>TF1</name>
              <description>定时器1溢出中断标志。中断服务程序中，硬件自动清零。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TR1</name>
              <description>定时器T1的运行控制位。该位由软件置位和清零。当GATE（TMOD.7）=0，TR1=1时就允许T1</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TF0</name>
              <description>定时器0溢出中断标志。中断服务程序中，硬件自动清零。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TR0</name>
              <description>定时器T0的运行控制位。该位由软件置位和清零。当GATE（TMOD.3）=0，TR0=1时就允许T0</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IE1</name>
              <description>外部中断1中断请求标志。中断服务程序中，硬件自动清零。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IT1</name>
              <description>INT1中断模式控制</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>上升沿中断+下降沿中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>下降沿中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IE0</name>
              <description>外部中断0中断请求标志。中断服务程序中，硬件自动清零。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IT0</name>
              <description>INT0中断模式控制</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>上升沿中断+下降沿中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>下降沿中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TMOD</name>
          <description>定时器模式寄存器</description>
          <addressOffset>0xf8101e9</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>T1_GATE</name>
              <description>控制定时器1，置1时只有在INT1脚为高及TR1控制位置1时才可打开定时器/计数器1。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>T1_C_T</name>
              <description>控制定时器1用作定时器或计数器，清0则用作定时器（对内部系统时钟进行计数），置1用作</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>T1_M1</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>T1_M0</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>T0_GATE</name>
              <description>控制定时器0，置1时只有在INT0脚为高及TR0控制位置1时才可打开定时器/计数器0。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>T0_C_T</name>
              <description>控制定时器0用作定时器或计数器，清0则用作定时器（对内部系统时钟进行计数），置1用作</description>
