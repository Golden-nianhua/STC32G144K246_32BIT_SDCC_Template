                <enumeratedValue>
                  <name>Value_3</name>
                  <description>-</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCETRS</name>
              <description>ADC 外部触发脚ADC_ETR 控制位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
