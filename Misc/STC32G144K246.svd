      <addressBlock>
        <offset>0x2d</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>S6CON</name>
          <description>串口6控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>S6SM0_FE</name>
              <description>当S6CFG寄存器中的S6MOD0位为1时，该位为帧错误检测标志位。当串口6在接收过程中检</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S6SM1</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S6SM2</name>
              <description>允许模式2 或模式3 多机通信控制位。当串口6 使用模式2 或模式3 时，如果S6SM2 位为1 且 S6REN 位为1，则接收机处于地址帧筛选状态。此时可以利用接收到的第9 位（即S6RB8）来筛 选地址帧，若S6RB8=1，说明该帧是地址帧，地址信息可以进入S6BUF，并使S6RI 为1，进而 </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S6REN</name>
              <description>允许/禁止串口接收控制位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止串口接收数据</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许串口接收数据</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S6TB8</name>
              <description>当串口6 使用模式2 或模式3 时，S6TB8 为要发送的第9 位数据，按需要由软件置位或清0。 在模式0 和模式1 中，该位不用。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S6RB8</name>
              <description>当串口6 使用模式2 或模式3 时，S6RB8 为接收到的第9 位数据，一般用作校验位或者地址帧 /数据帧标志位。在模式0 和模式1 中，该位不用。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S6TI</name>
              <description>串口6发送完成中断请求标志。需要软件清零。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S6RI</name>
              <description>串口6接收完成中断请求标志。需要软件清零。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
