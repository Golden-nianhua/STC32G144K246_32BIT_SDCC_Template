      <addressBlock>
        <offset>0x0</offset>
        <size>0x6</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x7</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>QSPI_CR1</name>
          <description>QSPI控制寄存器1</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ABORT</name>
              <description>中止请求。该位中止执行中的命令序列。在中止完成时自动复位。该位可停止当前的传输。在 轮询模式或内存映射模式下，该位也用以复位APM 位或DM 位。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>不请求中止</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>请求中止</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EN</name>
              <description>QSPI 功能使能控制位</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止QSPI</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能QSPI</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>QSPI_CR2</name>
          <description>QSPI控制寄存器2</description>
          <addressOffset>0x1</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>FTHRES</name>
              <description>FIFO 阈值级别（FIFO threshold level）。 定义在间接模式下FIFO 中将导致FIFO 阈值标志FTF 置1 的字节数阈值。 在间接写入模式下（FMODE = 00）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>QSPI_CR3</name>
          <description>QSPI控制寄存器3</description>
          <addressOffset>0x2</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>PMM</name>
              <description>轮询匹配模式（Polling match mode）。 该位指示在自动轮询模式期间用来确定是否匹配的方法。仅可在BUSY = 0 时修改该位。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>AND 匹配模式。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>OR 匹配模式。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>APMS</name>
              <description>自动轮询模式停止（Automatic poll mode stop） 该位确定在匹配后自动轮询是否停止。仅可在BUSY = 0 时修改该位。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>仅通过中止或禁用QSPI 停止自动轮询模式。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>发生匹配时，自动轮询模式停止。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SMIE</name>
              <description>QSPI状态匹配中断允许位。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止QSPI 状态匹配中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许QSPI 状态匹配中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FTIE</name>
              <description>QSPI FIFO阈值中断允许位。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止QSPI FIFO 阈值中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许QSPI FIFO 阈值中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TCIE</name>
              <description>QSPI传输完成中断允许位。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止QSPI 传输完成中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许QSPI 传输完成中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TEIE</name>
              <description>QSPI传输错误中断允许位。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止QSPI 传输错误中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许QSPI 传输错误中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>QSPI_CR4</name>
          <description>QSPI控制寄存器4</description>
          <addressOffset>0x3</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>PSCR</name>
              <description>时钟预分频器（Clock prescaler）。 对于奇数时钟分频系数，CLK 的占空比并非50%。时钟信号的高电平持续时间比低电平持续时间多 一个周期。仅可在BUSY = 0 时修改该位。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>QSPI_DCR1</name>
          <description>QSPI器件配置寄存器1</description>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>CSHT</name>
              <description>片选高电平时间（Chip select high time）。仅可在BUSY = 0 时修改该位。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>QSPI_IP</name>
              <description>QSPI中断优先级控制位</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>QSPI 中断优先级为0 级（最低级）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>QSPI 中断优先级为1 级（较低级）</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>QSPI 中断优先级为2 级（较高级）</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>QSPI 中断优先级为3 级（最高级）</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CKMODE</name>
              <description>SPI 模式0/模式3（Mode 0 / mode 3）选择位。该位指示CLK 在nCS=1 时的电平。仅可在 BUSY = 0 时修改该位。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>nCS 为高电平（片选释放）时，CLK 必须保持低电平。这称为模式0。</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>nCS 为高电平（片选释放）时，CLK 必须保持高电平。这称为模式3。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>QSPI_DCR2</name>
          <description>QSPI器件配置寄存器2</description>
          <addressOffset>0x5</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>FSIZE</name>
              <description>配置外部Flash 存储器的大小。仅可在BUSY = 0 时修改该位。 [FSIZE+1] Flash 中的字节数 = 2 FSIZE+1 是对 Flash 寻址所需的地址位数。在间接模式下，Flash 容量最高可达4GB（使用32 位进 行寻址）。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>QSPI_SR2</name>
          <description>QSPI状态寄存器2</description>
          <addressOffset>0x7</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>FLEVEL</name>
              <description>FIFO 级别（FIFO level） 该字段给出FIFO 中的有效字节数。FIFO 为空时FLEVEL = 0；写满时FLEVEL = 32 在自动状态轮询模式下，FLEVEL 为零。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>I2C1</name>
      <description>I2C1 主从配置、应答和中断状态</description>
      <baseAddress>0x007efd85</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xfb</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xfd</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xff</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x104</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>I2CTOSR</name>
          <description>I2C从机超时状态寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>I2CCTOF</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CTOIF</name>
              <description>I2C1 超时中断请求标志位。标志位需要软件向I2CCTOIF 位写“1”清零</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>I2CCFG</name>
          <description>2IC配置寄存器</description>
          <addressOffset>0xfb</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENI2C</name>
              <description>I2C 功能使能控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止I2C 功能</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许I2C 功能</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2CMSSL</name>
              <description>I2C 工作模式选择位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>从机模式</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>主机模式</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2CMSSPEED</name>
              <description>I2C 总线速度（等待时钟数）控制 I2C 总线速度＝SYSCLK / 2 / (I2CMSSPEED * 2 + 4) （I2C 最快速度为SYSCLK/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>I2CMSST</name>
          <description>2IC主机状态寄存器</description>
          <addressOffset>0xfd</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>I2CMSBUSY</name>
              <description>主机模式时I2C 控制器状态位（只读位）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>控制器处于空闲状态</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>控制器处于忙碌状态</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2CMSIF</name>
              <description>主机模式的中断请求位（中断标志位）。当处于主机模式的I2C控制器执行完成寄存器I2CMSCR 中MSCMD 命令后产生中断信号，硬件自动将此位1，向CPU 发请求中断，响应中断后MSIF 位必 须用软件清零。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CMSACKI</name>
              <description>主机模式时，发送“0011”命令到I2CMSCR 的I2CMSCMD 位后所接收到的ACK 数据。 （只读位）</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CMSACKO</name>
              <description>主机模式时，准备将要发送出去的 ACK 信号。当发送“0101”命令到 I2CMSCR 的 I2CMSCMD 位后，控制器会自动读取此位的数据当作ACK 发送到SDA。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>I2CSLST</name>
          <description>2IC从机状态寄存器</description>
          <addressOffset>0xff</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>I2CSLBUSY</name>
              <description>从机模式时I2C 控制器状态位（只读位）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>控制器处于空闲状态</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>控制器处于忙碌状态</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2CSTAIF</name>
              <description>从机模式时接收到START 信号后的中断请求位。从机模式的I2C 控制器接收到START 信号 后，硬件会自动将此位置1，并向CPU 发请求中断，响应中断后STAIF 位必须用软件清零。STAIF 被置1 的时间点如下图所示：</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CRXIF</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CTXIF</name>
              <description>从机模式时发送完成1 字节的数据后的中断请求位。从机模式的I2C 控制器发送完成1 字节 的数据并成功接收到1 位ACK 信号后，在第9 个时钟的下降沿时硬件会自动将此位置1，并向CPU</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CSTOIF</name>
              <description>从机模式时接收到STOP 信号后的中断请求位。从机模式的I2C 控制器接收到STOP 信号后， 硬件会自动将此位置1，并向CPU 发请求中断，响应中断后I2CSTOIF 位必须用软件清零。I2CSTOIF 被置1 的时间点如下图所示：</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CTXING</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CSLACKI</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CSLACKO</name>
              <description>从机模式时，准备将要发送出去的ACK 信号。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>I2CPSCR</name>
          <description>2IC时钟预分配寄存器</description>
          <addressOffset>0x104</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>I2CMSSPEED</name>
              <description>I2C 总线速度（等待时钟数）控制 I2C 总线速度＝SYSCLK / 2 / (I2CMSSPEED * 2 + 4) （I2C 最快速度为SYSCLK/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>I2C2</name>
      <description>I2C2 主从配置、应答和中断状态</description>
      <baseAddress>0x007ef860</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x2</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x4</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x9</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xd</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>I2C2CFG</name>
          <description>2IC配置寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENI2C2</name>
              <description>I2C2 功能使能控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止I2C2 功能</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>允许I2C2 功能</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2C2MSSL</name>
              <description>I2C2 工作模式选择位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>从机模式</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>主机模式</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2C2MSSPEED</name>
              <description>I2C2 总线速度（等待时钟数）控制 I2C2 总线速度＝SYSCLK / 2 / (I2C2MSSPEED * 2 + 4) （I2C2 最快速度为SYSCLK/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>I2C2MSST</name>
          <description>2IC主机状态寄存器</description>
          <addressOffset>0x2</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>I2C2MSBUSY</name>
              <description>主机模式时I2C2 控制器状态位（只读位）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>控制器处于空闲状态</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>控制器处于忙碌状态</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2C2MSIF</name>
              <description>主机模式的中断请求位（中断标志位）。需要软件清零。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C2MSACKI</name>
              <description>主机模式时，发送“0011”命令到I2C2MSCR 的I2C2MSCMD 位后所接收到的ACK 数 据。（只读位）</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C2MSACKO</name>
              <description>主机模式时，准备将要发送出去的 ACK 信号。当发送“0101”命令到 I2C2MSCR 的 I2C2MSCMD 位后，控制器会自动读取此位的数据当作ACK 发送到SDA2。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>I2C2SLST</name>
          <description>2IC从机状态寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>I2C2SLBUSY</name>
              <description>从机模式时I2C2 控制器状态位（只读位）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>控制器处于空闲状态</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>控制器处于忙碌状态</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2C2STAIF</name>
              <description>IC从机接收START事件中断请求标志。需要软件清零。 2</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C2RXIF</name>
              <description>IC从机接收数据完成事件中断请求标志。需要软件清零。 2</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C2TXIF</name>
              <description>IC从机发送数据完成事件中断请求标志。需要软件清零。 2</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C2STOIF</name>
              <description>IC从机接收STOP事件中断请求标志。需要软件清零。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C2TXING</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C2SLACKI</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C2SLACKO</name>
              <description>从机模式时，准备将要发送出去的ACK 信号。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>I2C2PSCR</name>
          <description>2IC时钟预分配寄存器</description>
          <addressOffset>0x9</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>I2C2MSSPEED</name>
              <description>I2C2 总线速度（等待时钟数）控制 I2C2 总线速度＝SYSCLK / 2 / (I2C2MSSPEED * 2 + 4) （I2C2 最快速度为SYSCLK/8）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
