    <peripheral>
      <name>UART1</name>
      <description>USART1 收发、运行模式与超时</description>
      <baseAddress>0x007efd71</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xf810327</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>UR1TOSR</name>
          <description>串口1接收超时状态寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>UR1TOIF</name>
              <description>串口1 超时中断请求标志位。标志位需要软件向UR1CTOIF 位写“1”清零</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SCON</name>
          <description>串口1控制寄存器</description>
          <addressOffset>0xf810327</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SM0_FE</name>
              <description>当PCON寄存器中的SMOD0位为1时，该位为帧错误检测标志位。当串口在接收过程中检测到</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SM1</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SM2</name>
              <description>允许模式2 或模式3 多机通信控制位。当串口1 使用模式2 或模式3 时，如果SM2 位为1 且REN 位为1，则接收机处于地址帧筛选状态。此时可以利用接收到的第9 位（即RB8）来筛选地址帧， 若RB8=1，说明该帧是地址帧，地址信息可以进入SBUF，并使RI 为1，进而在中断服务程序中 再进行地</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REN</name>
              <description>允许/禁止串口接收控制位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
