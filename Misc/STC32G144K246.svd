              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>转换结果左对齐。ADC2_RES 保存结果的高8 位，ADC2_RESL 保存结果的低4 位。格式如下：</description>
                  <value>0</value>
