              <description>SmartCard 模式时钟输出控制位</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止时钟输出</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能时钟输出</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S8SPMOD</name>
              <description>SPI 模式使能位</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止SPI 模式</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能SPI 模式</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S8SPIEN</name>
              <description>SPI 使能位</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止SPI 功能</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能SPI 功能</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S8SPSLV</name>
              <description>SPI 从机模式使能位</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>SPI 为主机模式</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>SPI 为从机模式</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S8CPOL</name>
              <description>SPI 时钟极性控制</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>SCLK 空闲时为低电平，SCLK 的前时钟沿为上升沿，后时钟沿为下降沿</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>SCLK 空闲时为高电平，SCLK 的前时钟沿为下降沿，后时钟沿为上升沿</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S8CPHA</name>
              <description>SPI 时钟相位控制</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>数据SS 管脚为低电平驱动第一位数据并在SCLK 的后时钟沿改变数据，前时钟沿采样数据</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>数据在SCLK 的前时钟沿驱动，后时钟沿采样</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>S8CFG</name>
          <description>串口8配置寄存器</description>
          <addressOffset>0x2d</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>S8MOD</name>
              <description>串口8 波特率控制位</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>SYSclk波特率=𝟔𝟒</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>SYSclk波特率=𝟑𝟐</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S8MOD0</name>
              <description>帧错误检测控制位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>无帧错检测功能</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能帧错误检测功能。此时S8CON 的S8SM0/FE 为FE 功能，即为帧错误检测标志位。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S8M0x6</name>
              <description>串口8 模式0 的通讯速度控制</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>串口8 模式0 的波特率不加倍，固定为Fosc/12</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>串口8 模式0 的波特率6 倍速，即固定为Fosc/12*6 ＝ Fosc/2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S8BRT</name>
              <description>串口8 波特率发生器选择位</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>选择定时器2 作为波特率发生器（默认值）</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>选择定时器8 作为波特率发生器</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>LIN</name>
      <description>LIN 共用控制和中断；不访问索引与数据口</description>
      <baseAddress>0x100000f9</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>LINICR</name>
          <description>LINBUS中断控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>PLIN2H</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LIN2IF</name>
              <description>LIN2 总线中断请求标志位，硬件清零（读取LSR 清零）。 PLIN2H，PLIN2L：LIN2 中断优先级控制位</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LIN2IE</name>
              <description>LIN2 总线中断使能控制位</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭LIN2 中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能LIN2 中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PLIN2L</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PLINH</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LINIF</name>
              <description>LIN 总线中断请求标志位，硬件清零（读取LSR 清零）。 PLINH，PLINL：LIN 中断优先级控制位</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LINIE</name>
              <description>LIN 总线中断使能控制位</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>关闭LIN 中断</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能LIN 中断</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PLINL</name>
              <description>尚未自动匹配到此字段的独立说明；请查看下方章节说明。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>ADC1</name>
      <description>ADC1 通道、触发、时序和转换结果</description>
      <baseAddress>0x007efea8</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1</size>
        <usage>registers</usage>
