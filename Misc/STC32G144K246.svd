            </field>
          </fields>
        </register>
        <register>
          <name>PWME_CR1</name>
          <description>PWME控制寄存器1</description>
          <addressOffset>0x20</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ARPEE</name>
              <description>自动预装载允许位（n=A/B/C/D/E/F）</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>PWMn_ARR 寄存器没有缓冲，它可以被直接写入</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>PWMn_ARR 寄存器由预装载缓冲器缓冲</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CMSE</name>
              <description>选择对齐模式（n=A/B/C/D/E/F）</description>
              <bitOffset>5</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>对齐模式：边沿对齐模式；说明：计数器依据方向位（DIR）向上或向下计数</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>对齐模式：中央对齐模式1；说明：计数器交替地向上和向下计数。配置为输出的通道的输出比较中断标志位(CCnIF)只在计数器向下计数时被置1。</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>对齐模式：中央对齐模式2；说明：计数器交替地向上和向下计数。配置为输出的通道的输出比较中断标志位(CCnIF)只在计数器向上计数时被置1。</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>对齐模式：中央对齐模式3；说明：计数器交替地向上和向下计数。配置为输出的通道的输出比较中断标志位(CCnIF)在计数器向上和向下计数时均被置1。</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIRE</name>
              <description>计数器的计数方向（n=A/B/C/D/E/F）</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>计数器向上计数；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>计数器向下计数。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OPME</name>
              <description>单脉冲模式（n=A/B/C/D/E/F）</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>在发生更新事件时，计数器不停止；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>在发生下一次更新事件时，清除CEN 位，计数器停止。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>URSE</name>
              <description>更新请求源（n=A/B/C/D/E/F）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>如果UDIS 允许产生更新事件，则下述任一事件产生一个更新中断：</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>如果UDIS 允许产生更新事件，则只有当下列事件发生时才产生更新中断，并UIF 置1：</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UDISE</name>
              <description>禁止更新（n=A/B/C/D/E/F）</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>一旦下列事件发生，产生更新（UEV）事件：</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>不产生更新事件，影子寄存器（ARR、PSC、CCRx）保持它们的值。如果设置了UG 位或时钟/</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CENE</name>
              <description>允许计数器（n=A/B/C/D/E/F）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>禁止计数器；</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>使能计数器。</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>PWME_CR2</name>
          <description>PWME控制寄存器2</description>
          <addressOffset>0x21</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MMSE</name>
              <description>主模式选择（n=A/C/E）</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>主模式：复位；说明：PWMn_EGR寄存器的UG位被用于作为触发输出（TRGO）。如果触发输入（时钟/触发控制器配置为复位模式）产生复位，则TRGO上的信号相对实际的复位会有一个延迟</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>主模式：使能；说明：计数器使能信号被用于作为触发输出（TRGO）。其用于启动多个PWM，以便控制在一段时间内使能从PWM。计数器使能信号是通过CEN控制位和门控模式下的触发输入信号的逻辑或产生。除非选择了主/从模式，当计数器使能信号受控于触发输入时，TRGO上会有一个延迟。</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_2</name>
                  <description>主模式：更新；说明：更新事件被选为触发输出（TRGO）</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_3</name>
                  <description>主模式：比较脉冲；说明：一旦发生一次捕获或一次比较成功，当CCn5IF标志被置1时，触发输出送出一个正脉冲（TRGO）</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_4</name>
                  <description>主模式：比较；说明：OCn5REF信号被用于作为触发输出（TRGO）</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_5</name>
                  <description>主模式：比较；说明：OCn6REF信号被用于作为触发输出（TRGO）</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_6</name>
                  <description>主模式：比较；说明：OCn7REF信号被用于作为触发输出（TRGO）</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_7</name>
                  <description>主模式：比较；说明：OCn8REF信号被用于作为触发输出（TRGO）</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>COMSE</name>
              <description>捕获/比较控制位的更新控制选择（n=A/B/C/D/E/F）</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>当CCPCn=1 时，只有在COMG 位置1 的时候这些控制位才被更新</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>当CCPCn=1 时，只有在COMG 位置1 或TRGI 发生上升沿的时候这些控制位才被更新</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCPCE</name>
              <description>捕获/比较预装载控制位（n=A/B/C/D/E/F）</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Value_0</name>
                  <description>CCIE，CCINE，CCiP，CCiNP 和OCIM 位不是预装载的</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Value_1</name>
                  <description>CCIE，CCINE，CCiP，CCiNP 和OCIM 位是预装载的；设置该位后，它们只在设置了COMG 位</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>PWME_IER</name>
          <description>PWME中断使能寄存器</description>
          <addressOffset>0x24</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
