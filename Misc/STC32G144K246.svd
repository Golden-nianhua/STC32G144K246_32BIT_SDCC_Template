          <addressOffset>0x11</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>RTCMONTH</name>
              <description>当前实时时间的月值。数字编码与MONTH 相同。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RTCDAY</name>
          <description>RTC的日计数值</description>
          <addressOffset>0x12</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>RTCDAY</name>
              <description>当前实时时间的日值。数字编码与DAY 相同。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RTCHOUR</name>
          <description>RTC的小时计数值</description>
          <addressOffset>0x13</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>RTCHOUR</name>
              <description>当前实时时间的小时值。数字编码与HOUR 相同。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RTCMIN</name>
          <description>RTC的分钟计数值</description>
          <addressOffset>0x14</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>RTCMIN</name>
              <description>当前实时时间的分钟值。数字编码与MIN 相同。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
